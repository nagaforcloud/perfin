# ─── PerFin Docker Configuration ──────────────────────────────────────────────
# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# API authentication (leave empty to disable)
PERFIN_API_KEY=

# Ports
PYTHON_PORT=8000
NODE_PORT=8001
LLM_PORT=8080

# LLM configuration (for llama-cpp service)
LLM_ENDPOINT=http://llama-cpp:8080/v1/chat/completions
LLM_MODEL_PATH=./models
LLM_MODEL_FILE=model.gguf

# Log level for Node backend (info, debug, warn, error)
LOG_LEVEL=info
