# Database (port 5433 — leaves host Postgres on 5432 alone)
DATABASE_URL=postgres://perfin:perfin@localhost:5433/perfin

# Auth
AUTH_SECRET=dev-only-replace-in-prod-with-openssl-rand-hex-32
AUTH_URL=http://localhost:3000

# OAuth (Phase 0: optional; placeholder values are fine in dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Worker
WORKER_PORT=8001
WORKER_URL=http://localhost:8001
WORKER_HMAC_SECRET=dev-shared-secret-replace-in-prod
NEXT_PUBLIC_WORKER_URL=http://localhost:8001

# Anthropic (Phase 1+)
ANTHROPIC_API_KEY=

# Plaid (Sandbox in dev)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# AES-256-GCM key for access tokens (32 bytes / 64 hex)
KMS_KEY=

# Postmark inbound
POSTMARK_INBOUND_USER=
POSTMARK_INBOUND_PASS=

# Inbound email
EMAIL_DOMAIN=in.perfin.app
EMAIL_HASH_SECRET=dev-email-hash-secret

# Plaid webhook URL
PLAID_WEBHOOK_URL=http://localhost:8001/webhooks/plaid
